# Copy to .env and fill in. Only DATABASE_URL and NEXTAUTH_SECRET are required.

APP_NAME="Beer Log"
# Used to build password reset links
APP_BASE_URL="http://localhost:3000"

DATABASE_URL="postgresql://user:password@localhost:5432/beerlog?schema=public"

# openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Derive callback URLs from the request host instead of NEXTAUTH_URL. Needed
# behind a proxy, or when reaching the dev server by LAN address.
# AUTH_TRUST_HOST="true"

# Hosts allowed to load Next.js dev resources from another machine, comma
# separated. Without this the client bundle is blocked and forms stop working.
# ALLOWED_DEV_ORIGINS="192.168.1.10"

# Password reset mail. Point at a local catcher such as mailpit in development.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_SENDER="Beer Log <beerlog@example.com>"

# Price of a drink, seeded into the settings table on first run
DEFAULT_BEER_PRICE_CENTS="100"
# Shown as a payment link, e.g. paypal.me/<id>
# PAYPAL_ME_ID=""

# Password for the admin account created by `pnpm seed`
INITIAL_ADMIN_PASSWORD=""

# Set to false to stop the container applying migrations on start
# RUN_MIGRATIONS="true"
